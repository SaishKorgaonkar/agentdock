# Runtime
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
RISK_API_URL=http://localhost:4001

# Ethereum / ENSv2 Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_OPERATOR_PRIVATE_KEY=
ENS_PARENT_NAME=
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
ENS_PROOF_RECORD_KEY=agentdock.phase0
ENS_PROOF_RECORD_VALUE=agentdock-sepolia-proof-v1

# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_X402_RECIPIENT_ID=
HEDERA_TRANSFER_TINYBARS=10000

# Chainlink CRE
CRE_TARGET=staging-settings
CRE_PROJECT_DIRECTORY=

# Persistence and service signing (provision per environment)
# SQLite file URL for local workflow-event persistence.
DATABASE_URL=file:./agentdock.sqlite
REPORT_SIGNING_PRIVATE_KEY=
